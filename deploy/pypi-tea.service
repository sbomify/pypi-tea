[Unit]
Description=pypi-tea - TEA Server for PyPI Package SBOMs
After=network.target redis.service
Wants=redis.service
# Tolerate a genuinely broken service flapping for ~10min before giving up
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# Type=notify: app signals READY=1 from its lifespan startup and pings WATCHDOG=1
# every ~15s (half of WatchdogSec).  A stuck event loop stops the pings and
# systemd kills + restarts the service.
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=pypi-tea
Group=pypi-tea

# App configuration
Environment=PYPI_TEA_REDIS_URL=redis://localhost:6379/0
Environment=PYPI_TEA_SERVER_ROOT_URL=http://localhost:8000

# uvx needs writable dirs for cache and tool installs
Environment=XDG_CACHE_HOME=/tmp/pypi-tea/cache
Environment=XDG_DATA_HOME=/tmp/pypi-tea/data
Environment=HOME=/tmp/pypi-tea

ExecStart=/usr/local/bin/uvx --python 3.14 --from pypi-tea@latest python -m uvicorn pypi_tea.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --limit-max-requests 5000

Restart=on-failure
RestartSec=5
MemoryMax=2G

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/pypi-tea

[Install]
WantedBy=multi-user.target
