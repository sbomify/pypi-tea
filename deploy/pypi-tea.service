[Unit]
Description=pypi-tea - TEA Server for PyPI Package SBOMs (API)
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=exec
User=pypi-tea
Group=pypi-tea
EnvironmentFile=-/etc/default/pypi-tea
Environment=PYPI_TEA_DATABASE_PATH=/var/lib/pypi-tea/pypi-tea.db
Environment=PYPI_TEA_BIND=127.0.0.1:8000
StateDirectory=pypi-tea

# Gunicorn supervises one uvicorn worker per CPU, each on its own SO_REUSEPORT
# socket, and replaces any worker whose event loop stops responding.
ExecStart=/opt/pypi-tea/bin/pypi-tea-serve

Restart=always
RestartSec=2
MemoryHigh=3G
MemoryMax=4G

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
