[Unit]
Description=pypi-tea arq worker (package refresh jobs)
After=network.target redis.service
Wants=redis.service

[Service]
Type=exec
User=pypi-tea
Group=pypi-tea

Environment=PYPI_TEA_REDIS_URL=redis://localhost:6379/0
Environment=PYPI_TEA_WORKER_MAX_JOBS=5
Environment=XDG_CACHE_HOME=/tmp/pypi-tea/cache
Environment=XDG_DATA_HOME=/tmp/pypi-tea/data
Environment=HOME=/tmp/pypi-tea

ExecStart=/usr/local/bin/uvx --python 3.14 --from pypi-tea@latest pypi-tea-worker

Restart=always
RestartSec=10
MemoryMax=1500M
MemoryHigh=1200M
TasksMax=128

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/pypi-tea

[Install]
WantedBy=multi-user.target
