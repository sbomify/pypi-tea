[Unit]
Description=pypi-tea ingest worker (PyPI fetches, SBOM extraction, attestation checks)
After=network.target

[Service]
Type=exec
User=pypi-tea
Group=pypi-tea
EnvironmentFile=-/etc/default/pypi-tea
Environment=PYPI_TEA_DATABASE_PATH=/var/lib/pypi-tea/pypi-tea.db
StateDirectory=pypi-tea

ExecStart=/opt/pypi-tea/bin/pypi-tea-worker

Restart=always
RestartSec=5
TimeoutStopSec=60
MemoryHigh=1200M
MemoryMax=1500M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
